rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role-based access control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isProvider() {
      return hasRole('provider');
    }

    function isCustomer() {
      return hasRole('customer');
    }

    // 1. Users collection: users {role, name, phone, city, createdAt}
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Providers collection: providers {userId, skills[], experienceYears, serviceArea, bio, status, ...}
    match /providers/{providerId} {
      // Anyone authenticated can read approved providers; provider can read own profile; admin can read all
      allow read: if isAuthenticated() && (
        resource.data.status == 'approved' || 
        request.auth.uid == resource.data.userId || 
        request.auth.uid == providerId ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (request.auth.uid == providerId || request.auth.uid == request.resource.data.userId);
      // Provider can update basic profile info, but CANNOT self-edit status, testScore, verifiedSkills, ratingAvg, ratingCount, jobsDone, or isSuspended
      allow update: if isAdmin() || (
        (request.auth.uid == providerId || request.auth.uid == resource.data.userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'testScore', 'verifiedSkills', 'ratingAvg', 'ratingCount', 'jobsDone', 'isSuspended'
        ])
      );
      allow delete: if isAdmin();
    }

    // 3. Services and Categories: public read, admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Bookings collection: bookings {customerId, providerId, serviceId, ...}
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.customerId || 
        request.auth.uid == resource.data.providerId || 
        isAdmin()
      );
      // Customer can create booking
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.customerId || 
        isAdmin()
      );
      // Customer, assigned provider, or admin can update booking status & timeline
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.customerId || 
        request.auth.uid == resource.data.providerId || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. Reviews collection: reviews {bookingId, customerId, providerId, rating, comment, createdAt}
    match /reviews/{reviewId} {
      allow read: if true; // Public verified reviews for transparent trust
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.customerId;
      allow update, delete: if isAdmin(); // Admin can moderate/hide abusive reviews
    }

    // 6. Question bank: test questions per category
    match /questionBank/{questionId} {
      // Questions can only be managed by admin
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Test attempts: testAttempts {providerId, categoryId, score, passed, takenAt}
    match /testAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.providerId || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.providerId || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // 9. Disputes / complaints
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.customerId || 
        request.auth.uid == resource.data.providerId || 
        isAdmin()
      );
      // Customer can create a dispute on their booking
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.customerId ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 10. Platform Settings (e.g. passMark threshold, global features)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
