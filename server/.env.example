# FixNear Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixnear?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by: npm run create-admin)
ADMIN_EMAIL=admin@fixnear.com
ADMIN_PASSWORD=AdminSecurePass123!

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Nodemailer SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FixNear Trust <noreply@fixnear.com>"
