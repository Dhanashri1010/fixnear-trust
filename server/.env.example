# FixNear Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixnear?retryWrites=true&w=majority

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by: npm run create-admin)
ADMIN_EMAIL=admin@fixnear.com
ADMIN_PASSWORD=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway & Webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Test Provider Credentials (used by: npm run create-test-provider, local dev only)
TEST_PROVIDER_EMAIL=provider.test@fixnear.com
TEST_PROVIDER_PASSWORD=
TEST_PROVIDER_CITY=Mumbai

# Nodemailer SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FixNear Trust <noreply@fixnear.com>"
