rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // KYC Documents (Govt ID Proof & Trade Certificates)
    // 5 MB limit, JPG/PNG/PDF only
    match /kyc/{userId}/{fileName} {
      allow write: if isOwner(userId)
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png)|application/pdf');
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Dispute attachments (photos uploaded by customer/provider)
    match /disputes/{disputeId}/{fileName} {
      allow write: if isAuthenticated()
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
