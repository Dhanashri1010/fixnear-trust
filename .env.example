# ===================================================================
# FixNear Trust - Environment Configuration
# ===================================================================
# Replace the placeholder values with your Firebase Project credentials
# from the Firebase Console (Project Settings > General > Your Apps > Web app).

VITE_FIREBASE_API_KEY=AIzaSyExampleFakeKeyForDemoPurposeOnly123
VITE_FIREBASE_AUTH_DOMAIN=fixnear-trust.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fixnear-trust
VITE_FIREBASE_STORAGE_BUCKET=fixnear-trust.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Dev & Evaluator Flags
# Set VITE_DEMO_MODE=true for local presentation/evaluator toolbar and mock demo accounts.
# Set VITE_DEMO_MODE=false in production to completely remove toolbar and seeder UI.
VITE_DEMO_MODE=true
VITE_ENABLE_DEV_DEMO_SWITCHER=true

# Optional: Cloud Functions base URL for server-side evaluation (Phase 3)
VITE_FIREBASE_FUNCTIONS_URL=
